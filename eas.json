  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.4.3",
      "node": "24.22.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "bun": "1.4.3",
      "node": "24.22.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://budget-tracker-five-pi-21.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "bun": "1.4.3",
      "node": "24.22.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://budget-tracker-five-pi-21.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
